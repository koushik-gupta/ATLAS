# ── LLM (Groq) ───────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── SerpApi (Flights via Google Flights engine) ───────────────────────
# Free tier: 250 searches/month — no credit card needed
# Register at: https://serpapi.com/users/sign_up
SERPAPI_KEY=your_serpapi_key_here

# ── Foursquare Places API (Hotels + Attractions) ──────────────────────
# Free tier: 10,000 calls/month — no credit card needed
# Register at: https://developer.foursquare.com → Settings → Generate Service API Key
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# ── Open-Meteo (Weather) ──────────────────────────────────────────────
# Completely free — no API key needed, no registration required
# Docs: https://open-meteo.com/en/docs

# ── LangSmith (optional — for graph tracing & debugging) ─────────────
# Register at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=travel-planner-agent
